# Copy to .env and adjust. Never commit .env.

# Postgres container credentials (used by docker-compose)
POSTGRES_USER=metals
POSTGRES_PASSWORD=metals
POSTGRES_DB=metals

# App settings
DATABASE_URL=postgresql+psycopg://metals:metals@db:5432/metals
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated emails that get the admin role when they register
ADMIN_EMAILS=admin@example.cz

# Tests only: separate database (created automatically if missing)
TEST_DATABASE_URL=postgresql+psycopg://metals:metals@localhost:5432/metals_test
